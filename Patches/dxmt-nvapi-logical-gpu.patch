+NVAPI_INTERFACE
+NvAPI_GetLogicalGPUFromPhysicalGPU(NvPhysicalGpuHandle physical, NvLogicalGpuHandle *logical) {
+  if (!physical || !logical)
+    return NVAPI_INVALID_ARGUMENT;
+  NvPhysicalGpuHandle devices[NVAPI_MAX_PHYSICAL_GPUS];
+  NvU32 count = 0;
+  auto status = dxmt::NvAPI_EnumPhysicalGPUs(devices, &count);
+  if (status != NVAPI_OK)
+    return status;
+  for (NvU32 i = 0; i < count; i++) {
+    if (devices[i] == physical) {
+      // DXMT maps physical and logical handles to the same Metal registry ID.
+      *logical = reinterpret_cast<NvLogicalGpuHandle>(physical);
+      return NVAPI_OK;
+    }
+  }
+  return NVAPI_INVALID_ARGUMENT;
 }
 
