+/* The launcher is a Qt application. A Windows session-end message tears
+ * down its windows without following its tray Exit action. Queue that action
+ * on Qt's owning thread instead. Use only the already loaded Qt 5 x64 ABI;
+ * no Qt code or launcher DLL is bundled with this integration. */
+#ifdef _WIN64
+struct zmd_qt_argument { const void *data; const char *name; };
+
+static BOOL zmd_launcher_quit(HMODULE qt)
+{
+    void * (CDECL *instance)(void);
+    unsigned char (CDECL *invoke)(void *, const char *, int,
+        struct zmd_qt_argument, struct zmd_qt_argument, struct zmd_qt_argument,
+        struct zmd_qt_argument, struct zmd_qt_argument, struct zmd_qt_argument,
+        struct zmd_qt_argument, struct zmd_qt_argument, struct zmd_qt_argument,
+        struct zmd_qt_argument);
+    struct zmd_qt_argument empty = {NULL, NULL};
+    void *app;
+
+    instance = (void *)GetProcAddress(qt, "?instance@QCoreApplication@@SAPEAV1@XZ");
+    invoke = (void *)GetProcAddress(qt,
+        "?invokeMethod@QMetaObject@@SA_NPEAVQObject@@PEBDW4ConnectionType@Qt@@VQGenericArgument@@333333333@Z");
+    if (!instance || !invoke || !(app = instance())) return FALSE;
+    /* Qt::QueuedConnection = 2; this is the launcher's own tray Exit slot. */
+    return invoke(app, "OnTrayReqExitApp", 2, empty, empty, empty, empty, empty,
+                  empty, empty, empty, empty, empty);
+}
+#endif
